{
  "name": "cli",
  "version": "0.0.1",
  "type": "module",
  "bin": {
    "mono": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "mono": "bun ./src/index.ts",
    "build": "bun build ./src/index.ts --outfile dist/index.js --target node --banner \"#!/usr/bin/env node\" --external ink --external react --external ink-text-input",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "lint": "bun run typecheck && bunx @biomejs/biome lint .",
    "format": "bunx @biomejs/biome format --write .",
    "test": "bun test"
  },
  "dependencies": {
    "ink": "^6.8.0",
    "ink-markdown": "^1.0.4",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.4",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.14",
    "@types/yargs": "^17.0.35",
    "typescript": "~5.9.3"
  }
}
