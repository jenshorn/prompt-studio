#!/bin/sh

# ──────────────────────────────────────────────────────────
# pstdio post-ticket-archive hook
# Runs after a ticket is archived.
#
# Removes all worktrees for the ticket.
# ──────────────────────────────────────────────────────────

pstdio tickets worktrees remove-all --id "$PSTDIO_TICKET"
